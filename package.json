{
  "name": "my-app",
  "private": true,
  "version": "0.1.679",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-build-tag.mjs && tsc -b && vite build && vite build --config vite.seed.config.ts && vite build --config vite.blocks.config.ts && vite build --config vite.build.config.ts",
    "build:seed": "vite build --config vite.seed.config.ts",
    "build:blocks": "vite build --config vite.blocks.config.ts",
    "catalog:sync": "python3 scripts/catalog/sync_catalog.py",
    "catalog:previews": "python3 scripts/catalog/render_previews.py",
    "catalog:check": "python3 scripts/catalog/check_catalog.py",
    "build:blocks:catalog": "npm run catalog:sync && npm run catalog:previews && npm run catalog:check && npm run build:blocks",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:textures": "node catalog/buildMasterAtlas.js --atlas-only && node catalog/patchBlockTiles.mjs && node catalog/patchBlockFlags.mjs && node catalog/textureCheck.mjs",
    "download:textures": "node scripts/download-catalog-textures.mjs",
    "snapshot": "bash scripts/snapshot.sh",
    "rollback": "bash scripts/rollback.sh",
    "log": "git log --oneline --decorate -n 15",
    "tags": "git tag -l -n1",
    "sim": "node scripts/sim/sim.sh",
    "sim:test": "tsx scripts/sim/tests.mts",
    "phase1:check": "tsx scripts/phase1-check.mts",
    "sim:reset": "rm -f data/sim-dev.db* && echo 'sim dev DB reset'",
    "audit:textures": "node catalog/textureCheck.mjs",
    "kb:sync": "node scripts/syncKbIndex.mjs",
    "kb:coverage": "node scripts/kbCoverage.mjs",
    "kb:wiki": "node scripts/kbWiki.mjs",
    "kb:read": "node scripts/kbRead.mjs",
    "kb:expand": "node scripts/kbExpand.mjs",
    "kb:conform": "node scripts/kbConform.mjs",
    "kb:touch": "node scripts/kbTouch.mjs",
    "kb:check": "node scripts/syncKbIndex.mjs --check && node scripts/kbCoverage.mjs && node scripts/kbConform.mjs",
    "pages:check": "node scripts/crossCheckPages.mjs",
    "ci:perf": "tsc -b && npm run build && npm run sim:test && node catalog/textureCheck.mjs && node scripts/test-worker-meshing.mjs && node scripts/ci-perf.mjs --gate && npm run kb:check && npm run pages:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
