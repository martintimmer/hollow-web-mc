{
  "generatorVersion": "procedural terrain (Game.tsx → src/game/terrain refactor)",
  "structure": {
    "pipeline": [
      "seed text → javaHash → seed → seedMix (Math.imul(seed, 2246822519)|0)",
      "seedMix + world preset (scale/hill/mtn/temp/island) → makeNoise (hash2/hash3/vnoise/vnoise3D/ridge)",
      "rawHeight(x,z): continental + erosion splines, micro-detail, ridge mountains, river carve, fjord, island lift",
      "terrainHeight(x,z): cached rawHeight (heightCache, 32k cap)",
      "surfaceAt(x,z): elevation+slope+temp → surface block (grass/sand/snow/stone/gravel/mud)",
      "getBiome(x,z): tempAt + humidity + forest + wetness noise → sampleBiome (Voronoi over BIOME_TARGETS + special pockets)",
      "scatter(x,z): biome.tree → tree generator, flowers/tall-grass, sugar cane, coral/kelp, boulders",
      "genChunk(cx,cz): fills voxels (bedrock, strata+ores, caves), scatter, villages, shipwrecks, springs, replays edits"
    ]
  },
